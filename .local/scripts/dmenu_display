#! /usr/bin/env bash

selected=$(
    {
        printf "Laptop Display\nSecond Display\nDuplicate\n"
        printf "Dual Display (L: HDMI R: Laptop)\n"
        printf "Dual Display (L: Laptop R: HDMI)\n"
    } | dmenu -c -i -z 500 -l 8 -p "display:"
)

case "$selected" in
    "Laptop Display") laptop_display ;;
    "Second Display") second_display ;;
    "Duplicate")      duplicate_display ;;
    "Dual Display (L: HDMI R: Laptop)") dual_right_display;;
    "Dual Display (L: Laptop R: HDMI)")  dual_left_display;;
esac
