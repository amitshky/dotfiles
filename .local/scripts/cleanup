#! /usr/bin/env bash

rm -r $HOME/.cache/thumbnails/*
rm -r $HOME/.cache/qimgv/thumbnails/*
rm -r $HOME/.cache/ueberzugpp/*
rm -r /tmp/yazi*

rm $HOME/.local/share/recently-used.xbel
rm $HOME/.local/share/qBittorrent/logs/qbittorrent.log

awk '
/^\[ExtHistoryCombo/ {skip=1; next}
/^\[/ {skip=0}
!skip
' ~/.config/krenamerc > ~/.config/krenamerc.new &&
mv ~/.config/krenamerc.new ~/.config/krenamerc

sed -i \
  -e '/^LastPlayedFile=/d' \
  -e '/^LastUrl=/d' \
  ~/dotfiles/.config/haruna/haruna.conf
