#!/usr/bin/env bash

SHUTDOWN="⏻  Shutdown"
LOCK="󰌾  Lock (Mod+Shift+L)"
SLEEP="⏾  Sleep"
RESTART="  Restart"
LOGOUT="󰍃  Logout"

menu=$(
    printf "%s\n%s\n%s\n%s\n%s\n" \
        "$SHUTDOWN" \
        "$LOCK" \
        "$SLEEP" \
        "$RESTART" \
        "$LOGOUT" |
    dmenu -i -l 5 -c -p "power:"
)

case "$menu" in
    "$SHUTDOWN") systemctl poweroff -i ;;
    "$SLEEP")    systemctl suspend -i ;;
    "$RESTART")  systemctl reboot -i ;;
    "$LOGOUT")   pkill dwm ;;
    "$LOCK")     lockscreen ;;
    *) exit 1 ;;
esac
